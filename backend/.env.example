OPENAI_API_KEY=your_openai_key_here
SERPAPI_API_KEY=your_serpapi_key_here

# Comma-separated list of origins allowed to call this API (CORS). Defaults
# to the frontend's local dev origins if unset - only needed if you're
# accessing the frontend from a different host/port, e.g. another device's
# LAN IP.
# FRONTEND_ORIGINS=http://localhost:8080,http://192.168.1.50:8080

# Outlook draft-creation (see README.md "Outlook draft setup" for the Azure
# app-registration steps). MS_GRAPH_MAILBOX is documentation/display only -
# calls use /me/, so the actual mailbox is whichever account completed the
# device-code sign-in in scripts/authorize_outlook.py. Drafts are addressed
# to the real contact's email on file - there is no test-recipient override.
MS_GRAPH_CLIENT_ID=your_azure_app_client_id_here
MS_GRAPH_TENANT_ID=your_azure_tenant_id_here
MS_GRAPH_MAILBOX=ajeppu@egglighting.com
